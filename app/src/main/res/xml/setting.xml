<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">



    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>



        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root"
                android:defaultValue="false" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <ListPreference
                app:key="private_dns_mode"
                app:title="Private DNS"
                app:summary="%s"
                android:entries="@array/dns_mode_entries"
                android:entryValues="@array/dns_mode_values"
                android:defaultValue="system" />

        <EditTextPreference
                app:key="private_dns_custom"
                app:title="Custom DNS Server / Hostname"
                app:summary="%s"
                app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <Preference
                android:key="send_logs"
                android:title="Send Logs"
                android:summary="Upload debug logs to developer" />

    </PreferenceCategory>

</PreferenceScreen>